{
	"name": "codeblock-customizer",
	"version": "1.3.2",
	"description": "The plugin lets you customize your Obsidian code blocks and inline code in editing mode and reading mode as well.",
	"main": "main.js",
	"scripts": {
		"dev": "concurrently \"npm run css -- --watch\" \"node esbuild.config.mjs\"",
		"build": "npm run css && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"css": "sass src/css/main.scss styles.css --no-source-map",
		"lint:css": "stylelint \"src/css/**/*.scss\"",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/stylelint-plugin": "^2.1.2",
    "@types/dompurify": "^3.0.3",
    "@types/lodash": "^4.14.197",
    "@types/node": "^16.11.6",
    "@types/validator": "^13.12.0",
    "builtin-modules": "3.3.0",
    "concurrently": "^9.2.1",
    "esbuild": "0.17.3",
    "eslint": "^9.39.2",
    "globals": "^17.1.0",
    "obsidian": "latest",
    "sass": "^1.97.3",
    "stylelint": "^16.2.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-declaration-block-no-ignored-properties": "^2.8.0",
    "stylelint-gamut": "^1.3.4",
    "stylelint-high-performance-animation": "^1.11.0",
    "stylelint-no-nested-media": "^0.1.0",
    "stylelint-order": "^6.0.4",
    "stylelint-plugin-defensive-css": "^1.0.4",
    "stylelint-scss": "^6.3.0",
    "stylelint-use-logical-spec": "^5.0.1",
    "tslib": "2.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1"
  },
	"dependencies": {
		"@codemirror/language": "^6.8.0",
		"@codemirror/search": "^6.5.6",
		"@lezer/common": "^1.1.0",
		"@simonwep/pickr": "^1.8.2",
		"html-to-image": "^1.11.13",
		"lodash": "^4.17.21",
		"validator": "^13.12.0"
	}
}
